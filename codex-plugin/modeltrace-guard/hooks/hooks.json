{
  "description": "Opt-in Codex frozen-snapshot fork probes with offline scoring, mismatch notifications and a work-tool halt guard. Requires hook trust review.",
  "hooks": {
    "PreToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 2 }] }]
  }
}
