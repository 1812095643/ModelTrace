{
  "description": "Opt-in background frozen-snapshot fork probes. Normal results are silent; mismatches notify and pause work through a synchronous tool guard. Requires hook trust review.",
  "hooks": {
    "PreToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['background-hook']))\"", "async": true, "timeout": 1000120, "additionalContextLimit": 6000 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['background-hook']))\"", "async": true, "timeout": 1000120, "additionalContextLimit": 6000 }] }],
    "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['background-hook']))\"", "async": true, "timeout": 1000120, "additionalContextLimit": 6000 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 5, "additionalContextLimit": 2000 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'scripts','guard.mjs')).href).then(m=>m.main(['hook']))\"", "timeout": 2 }] }]
  }
}
